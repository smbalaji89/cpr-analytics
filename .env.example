# ---------------------------------------------------------------------------
# CPR Analytics — environment variables
# Copy to `.env.local` for local development. NEVER commit real values.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Use the SESSION POOLER / TRANSACTION POOLER connection string on Vercel.
# The app runs WITHOUT this set (see README "Running without a database"),
# but persistence, history beyond the provider window and cron sync need it.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional — only needed if you use the Supabase JS client / dashboard tooling.
# SUPABASE_URL and the SERVICE_ROLE key are server-only. Never expose the
# service-role key to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Market data provider ---------------------------------------------------
# The DEFAULT provider, used by any instrument that does not name its own.
# "yahoo"  free, delayed, no MCX  (default)
# "upstox" free, MCX included, 1-year read-only Analytics Token
# "mock"   synthetic, development only
#
# Leave this on yahoo. The Indian instruments route to Upstox on their own as
# soon as a token exists (see below); forcing everything to Upstox would break
# the COMEX/NYMEX contracts and bitcoin, which it does not cover.
MARKET_DATA_PROVIDER=yahoo

# --- Upstox (needed for ALL Indian instruments, including MCX) ---------------
# NOT gated on MARKET_DATA_PROVIDER. The six Indian instruments name Upstox as
# their preferred provider, so setting this token alone switches them over and
# removing it drops them back to the default. MCX is reachable ONLY this way.
#
# Generate an ANALYTICS TOKEN from the Upstox Developer Apps dashboard
# (Analytics tab). It is free, valid for ONE YEAR, needs no OAuth redirect, and
# is strictly read-only — it cannot place, modify or cancel orders, so a leaked
# token cannot trade. Only one is active per account; generating a new one
# revokes the previous.
UPSTOX_ACCESS_TOKEN=

# Reserved for providers that require authentication. Server-only.
MARKET_DATA_API_KEY=

# Guard rail: refuses to boot with the mock provider when NODE_ENV=production
# unless this is explicitly set to "true". Leave unset in production.
ALLOW_MOCK_PROVIDER_IN_PRODUCTION=

# --- Per-device full access -------------------------------------------------
# The site is PUBLIC by default: no data source, no system status, no Settings.
# Visit /unlock on a device and enter this key to give THAT device the full
# view; it is stored in an httpOnly cookie for a year. Rotating this value
# revokes every unlocked device at once.
#
# Leave it UNSET to make the deployment permanently public — with no key
# configured there is no cookie value that can ever verify.
#
# Generate with: openssl rand -hex 32
# Use a DIFFERENT value from CRON_SECRET; they protect different things.
ADMIN_ACCESS_KEY=

# --- Cron / admin protection ------------------------------------------------
# Long random string. Vercel Cron sends it as `Authorization: Bearer <secret>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Data retention ---------------------------------------------------------
# Days of CPR history to keep. PRD §21 specifies 90.
DATA_RETENTION_DAYS=90
