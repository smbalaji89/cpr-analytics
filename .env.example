# ---------------------------------------------------------------------------
# CPR Analytics — environment variables
# Copy to `.env.local` for local development. NEVER commit real values.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Use the SESSION POOLER / TRANSACTION POOLER connection string on Vercel.
# The app runs WITHOUT this set (see README "Running without a database"),
# but persistence, history beyond the provider window and cron sync need it.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional — only needed if you use the Supabase JS client / dashboard tooling.
# SUPABASE_URL and the SERVICE_ROLE key are server-only. Never expose the
# service-role key to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Market data provider ---------------------------------------------------
# "yahoo" (default, free, delayed) | "kite" (Zerodha, real-time + MCX) | "mock"
MARKET_DATA_PROVIDER=yahoo

# --- Zerodha Kite Connect (only when MARKET_DATA_PROVIDER=kite) -------------
# Exchange-sourced data: settles at the close rather than hours later, and is
# the only way to reach MCX contracts.
#
# IMPORTANT: the access token expires at 6 AM IST every day (a regulatory
# requirement) and can only be regenerated through an interactive browser
# login. There is no unattended refresh. Plan for a daily manual step, or stay
# on the yahoo provider.
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# Reserved for providers that require authentication. Server-only.
MARKET_DATA_API_KEY=

# Guard rail: refuses to boot with the mock provider when NODE_ENV=production
# unless this is explicitly set to "true". Leave unset in production.
ALLOW_MOCK_PROVIDER_IN_PRODUCTION=

# --- Cron / admin protection ------------------------------------------------
# Long random string. Vercel Cron sends it as `Authorization: Bearer <secret>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Data retention ---------------------------------------------------------
# Days of CPR history to keep. PRD §21 specifies 90.
DATA_RETENTION_DAYS=90
